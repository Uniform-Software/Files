<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FFMpegCore" Version="5.5.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native" Version="8.18.7" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp pulls 8.0.1, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): use the patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- PDFium (BSD-3 / Apache 2.0), to draw PDF pages (page organizer thumbnails). Only the natives of the published runtime ship. -->
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8076" />
    <PackageReference Include="bblanchon.PDFium.macOS" Version="156.0.8076" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="156.0.8076" />
  </ItemGroup>

  <!-- All UI and tool texts. Strings.resx is English (fallback), Strings.fr.resx is French. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>UniFiles.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
