<!-- Preferences › Signatures: the saved signatures; advanced options folded. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniFiles.App.ViewModels"
             xmlns:controls="using:UniFiles.App.Controls"
             xmlns:res="using:UniFiles.Core.Resources"
             x:Class="UniFiles.App.Views.SignatureSettingsView"
             x:DataType="vm:SignatureSettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.badge.strong">
      <Setter Property="Background" Value="{StaticResource LemonBrush}" />
    </Style>
    <Style Selector="Border.badge.strong TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Border.badge.warning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <!-- Advanced options: a card with a header that opens it, like the actions' accordion. -->
    <Style Selector="Border.advanced">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    </Style>
    <Style Selector="Button.advancedHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.advanced controls|Icon.chevron">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.advanced.open controls|Icon.chevron">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="Window:not(.reducedMotion) Border.advanced controls|Icon.chevron">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ContentControl.advancedBody">
      <Setter Property="RenderTransform">
        <TranslateTransform />
      </Setter>
    </Style>
    <Style Selector="Window:not(.reducedMotion) Border.advanced.open ContentControl.advancedBody">
      <Style.Animations>
        <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Both">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.separator">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.advanced TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <!-- A signature: the whole row opens it. -->
    <Style Selector="Button.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,40">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost" VerticalAlignment="Center" IsVisible="{Binding CanReturn}"
                Command="{Binding ReturnCommand}" Content="{x:Static res:Strings.Signatures_ReturnToSigning}" />
        <StackPanel Spacing="4" Margin="0,0,16,0">
          <TextBlock Classes="h1" Text="{x:Static res:Strings.Signatures_Title}" />
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.SignSettings_Subtitle}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <Border Classes="banner" IsVisible="{Binding HasNotice}">
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Classes.error="{Binding NoticeIsError}" />
      </Border>

      <Border Classes="card" IsVisible="{Binding HasNoSignature}">
        <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,12">
          <controls:ModuleBadge Size="44" Mosaic="True" Tile="{StaticResource SignatureBrush}" Icon="{StaticResource IconSignature}" HorizontalAlignment="Center" />
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.Signatures_Empty}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SignatureItemViewModel">
            <Button Classes="row" AutomationProperties.Name="{Binding Name}"
                    Command="{Binding $parent[ItemsControl].((vm:SignatureSettingsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
              <DockPanel>
                <controls:Icon DockPanel.Dock="Right" Size="16" Data="{StaticResource IconChevronRight}" VerticalAlignment="Center" Opacity="0.6" />
                <Border DockPanel.Dock="Left" Width="132" Height="48" Margin="0,0,16,0" CornerRadius="{StaticResource RadiusSmall}"
                        Background="{StaticResource CreamBrush}" ClipToBounds="True">
                  <Panel>
                    <controls:SignaturePad IsEditable="False" Ink="{StaticResource InkBrush}" IsHitTestVisible="False" IsVisible="{Binding HasDrawing}"
                                           Drawing="{Binding Drawing}" />
                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="6" IsVisible="{Binding HasImage}" />
                    <TextBlock Text="{x:Static res:Strings.Signatures_NoHandwriting}" FontSize="10.5" Foreground="#8A8475" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6" IsVisible="{Binding HasNoHandwriting}" />
                  </Panel>
                </Border>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <WrapPanel>
                    <TextBlock Classes="label" Text="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Border Classes="badge strong" IsVisible="{Binding IsQualified}"><TextBlock Text="{x:Static res:Strings.SignSettings_BadgeQualified}" /></Border>
                    <Border Classes="badge" IsVisible="{Binding IsHardware}"><TextBlock Text="{x:Static res:Strings.SignSettings_BadgeHardware}" /></Border>
                    <Border Classes="badge warning" IsVisible="{Binding ExpiresSoon}"><TextBlock Text="{x:Static res:Strings.SignSettings_BadgeSoon}" /></Border>
                    <Border Classes="badge warning" IsVisible="{Binding IsExpired}"><TextBlock Text="{x:Static res:Strings.SignSettings_BadgeExpired}" /></Border>
                  </WrapPanel>
                  <TextBlock Classes="caption" Text="{Binding Email}" IsVisible="{Binding HasEmail}" />
                  <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsImporting}">
        <Button Classes="primary" Command="{Binding CreateCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:Icon Size="16" Data="{StaticResource IconPlus}" />
            <TextBlock Text="{x:Static res:Strings.Signatures_Create}" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding PickImportCommand}" Content="{x:Static res:Strings.Signatures_Import}" />
      </StackPanel>
      <Border Classes="card" IsVisible="{Binding IsImporting}">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="{Binding ImportFileName, StringFormat={x:Static res:Strings.SignSettings_Password}}" />
          <Grid ColumnDefinitions="*,12,Auto,8,Auto">
            <TextBox Grid.Column="0" Text="{Binding ImportPassword}" PasswordChar="•" AutomationProperties.Name="{Binding ImportFileName, StringFormat={x:Static res:Strings.SignSettings_Password}}" />
            <Button Grid.Column="2" Classes="primary" Command="{Binding ConfirmImportCommand}" Content="{x:Static res:Strings.SignSettings_ImportConfirm}" IsDefault="True" />
            <Button Grid.Column="4" Classes="ghost" Command="{Binding CancelImportCommand}" Content="{x:Static res:Strings.Common_Cancel}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Advanced: organization, trusted authorities, time stamp (folded) -->
      <Border Classes="advanced" Classes.open="{Binding ShowAdvanced}" Margin="0,8,0,0">
        <StackPanel>
          <Button Classes="advancedHeader" Command="{Binding ToggleAdvancedCommand}" AutomationProperties.Name="{x:Static res:Strings.Signatures_Advanced}">
            <DockPanel>
              <controls:Icon Classes="chevron" DockPanel.Dock="Right" Size="16" Data="{StaticResource IconDown}" VerticalAlignment="Center" />
              <StackPanel Spacing="2" Margin="0,0,12,0">
                <TextBlock Classes="label" Text="{x:Static res:Strings.Signatures_Advanced}" />
                <TextBlock Classes="caption" Text="{x:Static res:Strings.Signatures_AdvancedHint}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Button>
          <ContentControl Classes="advancedBody" IsVisible="{Binding ShowAdvanced}">
        <StackPanel Spacing="20" Margin="20,0,20,22">
          <StackPanel Spacing="12">
            <TextBlock Classes="h2" Text="{x:Static res:Strings.SignSettings_Organization}" />
            <TextBlock Classes="caption" Text="{x:Static res:Strings.SignSettings_OrganizationHint}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Authorities}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AuthorityItemViewModel">
                  <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="14,10">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="ghost" Padding="10,2" MinHeight="30" Content="{x:Static res:Strings.SignSettings_Issue}"
                                Command="{Binding $parent[ItemsControl].((vm:SignatureSettingsViewModel)DataContext).StartIssueCommand}" CommandParameter="{Binding}" />
                        <Button Classes="ghost" Padding="10,2" MinHeight="30" Content="{x:Static res:Strings.SignSettings_ExportAuthority}"
                                Command="{Binding $parent[ItemsControl].((vm:SignatureSettingsViewModel)DataContext).ExportAuthorityCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="{Binding Name}" />
                        <TextBlock Classes="caption" Text="{Binding Detail}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="8" IsVisible="{Binding IsIssuing}">
              <TextBlock Classes="label" Text="{Binding Issuing.Name, FallbackValue=''}" />
              <Grid ColumnDefinitions="*,12,*">
                <TextBox Grid.Column="0" Text="{Binding MemberName}" Watermark="{x:Static res:Strings.SignSettings_MemberName}" AutomationProperties.Name="{x:Static res:Strings.SignSettings_MemberName}" />
                <TextBox Grid.Column="2" Text="{Binding MemberEmail}" Watermark="{x:Static res:Strings.SignSettings_Email}" AutomationProperties.Name="{x:Static res:Strings.SignSettings_Email}" />
              </Grid>
              <TextBox Text="{Binding MemberPassword}" PasswordChar="•" Watermark="{x:Static res:Strings.SignSettings_MemberPassword}"
                       AutomationProperties.Name="{x:Static res:Strings.SignSettings_MemberPassword}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding IssueCommand}" Content="{x:Static res:Strings.SignSettings_IssueConfirm}" />
                <Button Classes="ghost" Command="{Binding CancelIssueCommand}" Content="{x:Static res:Strings.Common_Cancel}" />
              </StackPanel>
            </StackPanel>
            <Grid ColumnDefinitions="*,12,Auto" IsVisible="{Binding !HasAuthorities}">
              <TextBox Grid.Column="0" Text="{Binding Organization}" Watermark="{x:Static res:Strings.SignSettings_OrganizationName}"
                       AutomationProperties.Name="{x:Static res:Strings.SignSettings_OrganizationName}" />
              <Button Grid.Column="2" Classes="ghost" Command="{Binding CreateAuthorityCommand}" Content="{x:Static res:Strings.SignSettings_CreateAuthority}" />
            </Grid>
          </StackPanel>

          <Border Classes="separator" />
          <StackPanel Spacing="12">
            <TextBlock Classes="h2" Text="{x:Static res:Strings.SignSettings_TrustedTitle}" />
            <TextBlock Classes="caption" Text="{x:Static res:Strings.SignSettings_TrustedHint}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Trusted}" IsVisible="{Binding HasTrusted}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrustedItemViewModel">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="ghost" Padding="10,2" MinHeight="30" Content="{x:Static res:Strings.SignSettings_Remove}" IsVisible="{Binding CanRemove}"
                            Command="{Binding $parent[ItemsControl].((vm:SignatureSettingsViewModel)DataContext).UntrustCommand}" CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding TrustAuthorityCommand}" Content="{x:Static res:Strings.SignSettings_Trust}" />
          </StackPanel>

          <Border Classes="separator" />
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{x:Static res:Strings.Signatures_TimestampTitle}" />
            <ToggleSwitch IsChecked="{Binding Timestamp}" Content="{x:Static res:Strings.SignSettings_Timestamp}" OnContent="" OffContent="" />
            <TextBlock Classes="caption" Text="{x:Static res:Strings.SignSettings_TimestampHint}" TextWrapping="Wrap" />
            <TextBox Text="{Binding TimestampUrl}" Watermark="https://…" IsEnabled="{Binding Timestamp}"
                     AutomationProperties.Name="{x:Static res:Strings.SignSettings_TimestampUrl}" ToolTip.Tip="{x:Static res:Strings.SignSettings_TimestampUrl}" />
          </StackPanel>
        </StackPanel>
          </ContentControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
