<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniFiles.App.ViewModels"
             xmlns:controls="using:UniFiles.App.Controls"
             xmlns:res="using:UniFiles.Core.Resources"
             x:Class="UniFiles.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <Button DockPanel.Dock="Right" Classes="ghost" IsVisible="{Binding !IsEmpty}" Command="{Binding ClearCommand}" AutomationProperties.Name="{x:Static res:Strings.History_Clear}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:Icon Size="16" Data="{StaticResource IconTrash}" />
          <TextBlock Text="{x:Static res:Strings.History_Clear}" />
        </StackPanel>
      </Button>
      <TextBlock Classes="h1" Text="{x:Static res:Strings.Nav_History}" VerticalAlignment="Center" />
    </DockPanel>

    <Panel>
      <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,0,0,80">
        <controls:Icon Size="40" Data="{StaticResource IconHistory}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        <TextBlock Classes="secondary" Text="{x:Static res:Strings.History_Empty}" HorizontalAlignment="Center" />
      </StackPanel>

      <ScrollViewer IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Entries}" Margin="0,0,0,32">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryItemViewModel">
              <Border Classes="card" Padding="18,12" Margin="0,0,0,8">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).OpenFolderCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{x:Static res:Strings.Common_OpenFolder}"
                          ToolTip.Tip="{x:Static res:Strings.Common_OpenFolder}">
                    <controls:Icon Size="16" Data="{StaticResource IconFolder}" />
                  </Button>
                  <Grid ColumnDefinitions="260,140,*" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <controls:ActionTag Text="{Binding ToolName}"
                                          Tile="{Binding Module.Brush, FallbackValue={x:Null}}"
                                          Icon="{Binding Module.Icon, FallbackValue={x:Null}}" />
                      <TextBlock Classes="caption" Text="{Binding DateText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding FilesText}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Classes="secondary" Text="{Binding GainText}" IsVisible="{Binding HasGain}" />
                      <TextBlock Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding HasErrors}" />
                    </StackPanel>
                  </Grid>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
