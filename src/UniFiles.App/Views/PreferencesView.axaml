<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniFiles.App.ViewModels"
             xmlns:controls="using:UniFiles.App.Controls"
             xmlns:res="using:UniFiles.Core.Resources"
             xmlns:services="using:UniFiles.App.Services"
             x:Class="UniFiles.App.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,40">
      <TextBlock Classes="h1" Text="{x:Static res:Strings.Nav_Preferences}" Margin="0,0,0,4" />

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{x:Static res:Strings.Prefs_OutputFolder}" />
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.Prefs_OutputFolderHint}" TextWrapping="Wrap" />
          <Border Classes="chip" Padding="12,10">
            <TextBlock Text="{Binding OutputDirectory}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OutputDirectory}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Command="{Binding BrowseOutputCommand}" Content="{x:Static res:Strings.Prefs_Change}" />
            <Button Classes="ghost" Command="{Binding OpenOutputCommand}" Content="{x:Static res:Strings.Common_OpenFolder}" />
            <Button Classes="ghost" Command="{Binding ResetOutputCommand}" Content="{x:Static res:Strings.Prefs_Reset}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="{x:Static res:Strings.Prefs_Appearance}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.Prefs_Theme}" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                      AutomationProperties.Name="{x:Static res:Strings.Prefs_Theme}" />
          </StackPanel>
          <StackPanel Spacing="2">
            <ToggleSwitch IsChecked="{Binding ReduceMotion}" Content="{x:Static res:Strings.Prefs_ReduceMotion}"
                          OnContent="" OffContent="" />
            <TextBlock Classes="caption" Text="{x:Static res:Strings.Prefs_ReduceMotionHint}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="{x:Static res:Strings.Prefs_System}" />
          <StackPanel Spacing="2">
            <ToggleSwitch IsChecked="{Binding ContextMenuEnabled}" IsEnabled="{Binding IsContextMenuSupported}"
                          Content="{Binding ContextMenuLabel}" OnContent="" OffContent="" />
            <TextBlock Classes="caption" Text="{Binding ContextMenuHint}" TextWrapping="Wrap" IsVisible="{Binding IsContextMenuSupported}" />
            <TextBlock Classes="caption" Text="{x:Static res:Strings.Prefs_ContextMenuUnsupported}" TextWrapping="Wrap" IsVisible="{Binding !IsContextMenuSupported}" />
            <TextBlock Classes="error" Text="{Binding ContextMenuError}" TextWrapping="Wrap" IsVisible="{Binding HasContextMenuError}" />
          </StackPanel>
          <StackPanel Spacing="2">
            <ToggleSwitch IsChecked="{Binding HardwareAcceleration}" Content="{x:Static res:Strings.Prefs_Hardware}" OnContent="" OffContent="" />
            <TextBlock Classes="caption" Text="{x:Static res:Strings.Prefs_HardwareHint}" TextWrapping="Wrap" />
            <TextBlock Classes="secondary" Text="{Binding EncoderStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding EncoderStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel Spacing="2">
            <ToggleSwitch IsChecked="{Binding KeepInTray}" Content="{x:Static services:PlatformText.KeepInTray}" OnContent="" OffContent="" />
            <TextBlock Classes="caption" Text="{x:Static res:Strings.Prefs_KeepInTrayHint}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{x:Static res:Strings.Update_Title}" />
          <StackPanel Spacing="12" IsVisible="{Binding Updater.IsSupported}">
            <StackPanel Spacing="2">
              <ToggleSwitch IsChecked="{Binding CheckForUpdates}" Content="{x:Static res:Strings.Update_Auto}" OnContent="" OffContent="" />
              <TextBlock Classes="caption" Text="{x:Static res:Strings.Update_AutoHint}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="secondary" Text="{Binding UpdateStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Command="{Binding InstallUpdateCommand}" Content="{x:Static res:Strings.Update_RestartNow}"
                      IsVisible="{Binding IsUpdateReady}" />
              <Button Classes="ghost" Command="{Binding CheckUpdatesCommand}" Content="{x:Static res:Strings.Update_CheckNow}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="caption" Text="{x:Static res:Strings.Update_Unsupported}" TextWrapping="Wrap" IsVisible="{Binding !Updater.IsSupported}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{x:Static res:Strings.Prefs_Language}" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                    AutomationProperties.Name="{x:Static res:Strings.Prefs_Language}" />
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.Prefs_RestartNeeded}" IsVisible="{Binding NeedsRestart}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <controls:Logo HorizontalAlignment="Left" />
          <TextBlock Classes="secondary" Text="{Binding Version}" />
          <TextBlock Text="{x:Static res:Strings.Prefs_About}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="{x:Static res:Strings.Prefs_Licenses}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Classes="ghost" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowReleaseNotesCommand}" Content="{x:Static res:Strings.Doc_ReleaseNotes}" />
            <Button Classes="ghost" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowLicensesCommand}" Content="{x:Static res:Strings.Prefs_ThirdParty}" />
            <Button Classes="ghost" Command="{Binding OpenLogsCommand}" Content="{x:Static res:Strings.Prefs_Logs}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
