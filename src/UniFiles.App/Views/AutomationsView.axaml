<!-- Automations: watched folders, each processed with a preset. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniFiles.App.ViewModels"
             xmlns:controls="using:UniFiles.App.Controls"
             xmlns:res="using:UniFiles.Core.Resources"
             x:Class="UniFiles.App.Views.AutomationsView"
             x:DataType="vm:AutomationsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,0,40">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding AddCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:Icon Size="16" Data="{StaticResource IconPlus}" />
            <TextBlock Text="{x:Static res:Strings.Auto_Add}" />
          </StackPanel>
        </Button>
        <StackPanel Spacing="4" Margin="0,0,16,0">
          <TextBlock Classes="h1" Text="{x:Static res:Strings.Auto_Title}" />
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.Auto_Intro}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <Border Classes="banner" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
      </Border>

      <Border Classes="card" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,12">
          <controls:ModuleBadge Size="44" Mosaic="True" Tile="{StaticResource LemonBrush}" Icon="{StaticResource IconAutomation}" HorizontalAlignment="Center" />
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.Auto_Empty}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Rules}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="16" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WatchRuleViewModel">
            <Border Classes="card">
              <StackPanel Spacing="16">
                <!-- Folder, on/off -->
                <DockPanel>
                  <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Enabled}" OnContent="" OffContent=""
                                AutomationProperties.Name="{x:Static res:Strings.Auto_Enabled}" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <controls:Icon Size="22" Data="{StaticResource IconFolder}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="h2" Text="{Binding FolderName}" />
                      <TextBlock Classes="caption" Text="{Binding FolderPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Rule.Folder}" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>

                <!-- Status -->
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes="secondary" Classes.error="{Binding HasError}" />

                <!-- Settings -->
                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,12,Auto">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Classes="label" Text="{x:Static res:Strings.Auto_Preset}" />
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{x:Static res:Strings.Auto_Preset}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="label" Text="{x:Static res:Strings.Auto_After}" />
                    <ComboBox ItemsSource="{Binding AfterChoices}" SelectedItem="{Binding SelectedAfter}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{x:Static res:Strings.Auto_After}" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                    <TextBlock Classes="label" Text="{x:Static res:Strings.Auto_Destination}" />
                    <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{x:Static res:Strings.Auto_Destination}" />
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="ghost" Padding="10,2" MinHeight="30" IsVisible="{Binding IsCustomOutput}"
                              Command="{Binding ChangeOutputCommand}" Content="{x:Static res:Strings.Output_Change}" />
                      <TextBlock Classes="caption" Text="{Binding OutputDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6" VerticalAlignment="Top">
                    <TextBlock Classes="label" Text="{x:Static res:Strings.Auto_Subfolders}" />
                    <ToggleSwitch IsChecked="{Binding IncludeSubfolders}" OnContent="" OffContent=""
                                  AutomationProperties.Name="{x:Static res:Strings.Auto_Subfolders}" />
                  </StackPanel>
                </Grid>

                <!-- Actions -->
                <WrapPanel>
                  <Button Classes="ghost" Margin="0,0,10,0" Command="{Binding ProcessExistingCommand}" Content="{x:Static res:Strings.Auto_ProcessExisting}" />
                  <Button Classes="ghost" Margin="0,0,10,0" Command="{Binding ShowFolderCommand}" Content="{x:Static res:Strings.Auto_ShowFolder}" />
                  <Button Classes="ghost" Command="{Binding RemoveCommand}" Content="{x:Static res:Strings.Auto_Remove}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Start at login -->
      <Border Classes="card" IsVisible="{Binding IsLoginSupported}">
        <StackPanel Spacing="2">
          <ToggleSwitch IsChecked="{Binding LaunchAtLogin}" Content="{x:Static res:Strings.Auto_LoginItem}" OnContent="" OffContent="" />
          <TextBlock Classes="caption" Text="{x:Static res:Strings.Auto_LoginItemHint}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
