<!--
  Form editor: page thumbnails on the left, the page with a control over each field in the
  middle, and in "Add fields" mode a panel to set the new fields up on the right.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniFiles.App.ViewModels"
             xmlns:controls="using:UniFiles.App.Controls"
             xmlns:res="using:UniFiles.Core.Resources"
             xmlns:services="using:UniFiles.App.Services"
             x:Class="UniFiles.App.Views.PdfFormEditorView"
             x:DataType="vm:PdfFormEditorViewModel">

  <UserControl.Styles>
    <Style Selector="Border.pageThumb">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.pageThumb.current">
      <Setter Property="BorderBrush" Value="{StaticResource LemonBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="0,0,0,24">

    <!-- Header: back, title, modes, zoom -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ToggleButton Classes="segment" IsChecked="{Binding !IsAdding, Mode=OneWay}" Command="{Binding FillModeCommand}" Content="{x:Static res:Strings.Form_ModeFill}" />
        <ToggleButton Classes="segment" IsChecked="{Binding IsAdding, Mode=OneWay}" Command="{Binding AddModeCommand}" Content="{x:Static res:Strings.Form_ModeAdd}" />
        <Border Width="12" />
        <Button Classes="icon" Command="{Binding ZoomOutCommand}" AutomationProperties.Name="{x:Static res:Strings.Form_ZoomOut}" ToolTip.Tip="{x:Static res:Strings.Form_ZoomOut}">
          <TextBlock Text="−" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
        </Button>
        <Button Classes="icon" Command="{Binding ZoomInCommand}" AutomationProperties.Name="{x:Static res:Strings.Form_ZoomIn}" ToolTip.Tip="{x:Static res:Strings.Form_ZoomIn}">
          <TextBlock Text="+" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="icon" Command="{Binding BackCommand}" AutomationProperties.Name="{x:Static res:Strings.Common_Back}">
          <controls:Icon Size="20" Data="{StaticResource IconBack}" />
        </Button>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:ModuleBadge Size="34" Tile="{StaticResource PdfBrush}" Icon="{StaticResource IconPdf}" />
            <TextBlock Classes="h1" Text="{x:Static res:Strings.Tool_PdfFormFill_Name}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="caption" Text="{Binding FileName}" />
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="140,16,*,16,Auto">
      <!-- Pages -->
      <ScrollViewer Grid.Column="0">
        <ItemsControl ItemsSource="{Binding Pages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FormPageViewModel">
              <Border Classes="pageThumb" Classes.current="{Binding IsCurrent}" Background="Transparent"
                      PointerPressed="OnThumbnailPressed" AutomationProperties.Name="{Binding Label}">
                <StackPanel Spacing="4">
                  <Border Background="{StaticResource CreamBrush}" CornerRadius="3" ClipToBounds="True" MinHeight="60">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                  </Border>
                  <TextBlock Classes="caption" Text="{Binding Label}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Page and fields -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True">
        <Panel>
          <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <LayoutTransformControl x:Name="Zoomer" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24">
              <Panel Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                <Border BoxShadow="0 4 24 0 #50000000" Background="{StaticResource CreamBrush}">
                  <Image Source="{Binding PageImage}" Stretch="Fill" />
                </Border>
                <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True" />
              </Panel>
            </LayoutTransformControl>
          </ScrollViewer>
          <controls:Loader HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
          <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" MaxWidth="420"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
        </Panel>
      </Border>

      <!-- Add fields panel -->
      <Border Grid.Column="4" Classes="panel" Width="260" Padding="18" IsVisible="{Binding IsAdding}">
        <ScrollViewer>
          <StackPanel Spacing="14">
            <TextBlock Classes="h2" Text="{x:Static res:Strings.Form_ModeAdd}" />
            <TextBlock Classes="caption" Text="{x:Static res:Strings.Form_AddHelp}" TextWrapping="Wrap" />
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{x:Static res:Strings.Form_FieldType}" />
              <ComboBox ItemsSource="{Binding NewKinds}" SelectedItem="{Binding SelectedNewKind}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Static res:Strings.Form_FieldType}" />
            </StackPanel>

            <Border Classes="card" Padding="14" IsVisible="{Binding HasSelection}">
              <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="{x:Static res:Strings.Form_FieldName}" />
                  <TextBox x:Name="FieldName" Text="{Binding SelectedField.Name, Mode=OneWay, FallbackValue=''}"
                           AutomationProperties.Name="{x:Static res:Strings.Form_FieldName}" />
                  <TextBlock Classes="error" Text="{Binding FieldError}" TextWrapping="Wrap"
                             IsVisible="{Binding FieldError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <ToggleSwitch IsChecked="{Binding SelectedField.Required, FallbackValue=False}" Content="{x:Static res:Strings.Form_FieldRequired}"
                              OnContent="" OffContent="" />
                <StackPanel Spacing="6" IsVisible="{Binding SelectedField.IsText, FallbackValue=False}">
                  <TextBlock Classes="label" Text="{x:Static res:Strings.Form_FontSize}" />
                  <NumericUpDown Value="{Binding SelectedField.FontSize, FallbackValue=0}" Minimum="0" Maximum="36" Increment="1" FormatString="0"
                                 AutomationProperties.Name="{x:Static res:Strings.Form_FontSize}" />
                  <TextBlock Classes="caption" Text="{x:Static res:Strings.Form_FontSizeHint}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Classes="ghost" Command="{Binding DeleteSelectedFieldCommand}" Content="{x:Static res:Strings.Form_DeleteField}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Bottom bar -->
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16">
        <StackPanel VerticalAlignment="Center" Spacing="0">
          <ToggleSwitch IsChecked="{Binding Flatten}" Content="{x:Static res:Strings.Form_Flatten}" OnContent="" OffContent=""
                        ToolTip.Tip="{x:Static res:Strings.Form_FlattenHint}" />
        </StackPanel>
        <Button Classes="primary" Command="{Binding SaveCommand}"
                HotKey="{OnPlatform Ctrl+Enter, macOS=Meta+Enter}" ToolTip.Tip="{x:Static services:PlatformText.LaunchShortcut}"
                AutomationProperties.Name="{x:Static res:Strings.Form_Save}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:Icon Size="16" Data="{StaticResource IconCheck}" />
            <TextBlock Text="{x:Static res:Strings.Form_Save}" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="icon" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="{x:Static res:Strings.Form_PreviousPage}">
          <controls:Icon Size="16" Data="{StaticResource IconChevronLeft}" />
        </Button>
        <TextBlock Classes="label" Text="{Binding PageLabel}" VerticalAlignment="Center" />
        <Button Classes="icon" Command="{Binding NextPageCommand}" AutomationProperties.Name="{x:Static res:Strings.Form_NextPage}">
          <controls:Icon Size="16" Data="{StaticResource IconChevronRight}" />
        </Button>
        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Classes="label" Text="{Binding Summary}" />
          <TextBlock Classes="caption" Text="{x:Static res:Strings.Form_NoFields}" IsVisible="{Binding HasNoFields}" />
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
