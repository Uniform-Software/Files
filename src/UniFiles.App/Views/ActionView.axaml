<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniFiles.App.ViewModels"
             xmlns:controls="using:UniFiles.App.Controls"
             xmlns:tools="using:UniFiles.Core.Tools"
             xmlns:res="using:UniFiles.Core.Resources"
             xmlns:services="using:UniFiles.App.Services"
             x:Class="UniFiles.App.Views.ActionView"
             x:DataType="vm:ActionViewModel">

  <!-- One control per kind of setting, for the first action and every chained step -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ChoiceOptionViewModel">
      <StackPanel Spacing="6" IsVisible="{Binding IsVisible}">
        <TextBlock Classes="label" Text="{Binding Label}" />
        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
                  AutomationProperties.Name="{Binding Label}" />
        <TextBlock Classes="caption" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:NumberOptionViewModel">
      <StackPanel Spacing="6" IsVisible="{Binding IsVisible}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="secondary" Text="{Binding DisplayValue}" IsVisible="{Binding UseSlider}" />
          <TextBlock Classes="label" Text="{Binding Label}" />
        </DockPanel>
        <Slider IsVisible="{Binding UseSlider}"
                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                Value="{Binding SliderValue}"
                SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                AutomationProperties.Name="{Binding Label}" />
        <NumericUpDown IsVisible="{Binding !UseSlider}"
                       Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                       Value="{Binding BoxValue}" Increment="10" FormatString="0"
                       HorizontalAlignment="Left" MinWidth="200"
                       AutomationProperties.Name="{Binding Label}" />
        <TextBlock Classes="caption" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:BoolOptionViewModel">
      <StackPanel Spacing="2" IsVisible="{Binding IsVisible}">
        <ToggleSwitch IsChecked="{Binding IsChecked}" Content="{Binding Label}"
                      OnContent="" OffContent=""
                      AutomationProperties.Name="{Binding Label}" />
        <TextBlock Classes="caption" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:TextOptionViewModel">
      <StackPanel Spacing="6" IsVisible="{Binding IsVisible}">
        <TextBlock Classes="label" Text="{Binding Label}" />
        <TextBox Text="{Binding Text}" AutomationProperties.Name="{Binding Label}" />
        <TextBlock Classes="caption" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- An action of the accordion: a header, and its settings once open. -->
    <Style Selector="Border.toolRow">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    </Style>
    <Style Selector="Border.toolRow.open">
      <Setter Property="BorderBrush" Value="{StaticResource LemonBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.toolHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.toolRow controls|Icon.chevron">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.toolRow.open controls|Icon.chevron">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="Window:not(.reducedMotion) Border.toolRow controls|Icon.chevron">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- The settings of an action slide in when it opens. -->
    <Style Selector="ContentControl.settings">
      <Setter Property="RenderTransform">
        <TranslateTransform />
      </Setter>
    </Style>
    <Style Selector="Window:not(.reducedMotion) Border.toolRow.open ContentControl.settings">
      <Style.Animations>
        <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Both">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.inner">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- The settings of the open action (its options, preset, chained steps, previews). -->
    <DataTemplate x:Key="ToolSettings" x:DataType="vm:ActionViewModel">
      <StackPanel Spacing="20">
            <StackPanel Spacing="16" IsVisible="{Binding HasOptions}">
                <DockPanel>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Classes="caption" IsVisible="{Binding ActivePreset, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Text="{Binding ActivePreset.Name, StringFormat={x:Static res:Strings.Preset_Active}, FallbackValue=''}" />
                    <TextBlock Classes="caption" Text="{Binding RecipeNote}"
                               IsVisible="{Binding RecipeNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="caption" Text="{Binding SettingsTitle}" IsVisible="{Binding HasSteps}" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>
                <Border Classes="banner" IsVisible="{Binding IsSavingPreset}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="{Binding PresetFormLabel}" />
                    <TextBox Text="{Binding PresetName}" Watermark="{x:Static res:Strings.Preset_NameExample}"
                             AutomationProperties.Name="{Binding PresetFormLabel}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SavePresetCommand}" />
                        <KeyBinding Gesture="Escape" Command="{Binding CancelSavingPresetCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Classes="error" Text="{Binding PresetError}" TextWrapping="Wrap"
                               IsVisible="{Binding PresetError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="caption" Text="{Binding PresetFormHint}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button Classes="primary" Command="{Binding SavePresetCommand}" Content="{x:Static res:Strings.Preset_SaveConfirm}" />
                      <Button Classes="ghost" Command="{Binding CancelSavingPresetCommand}" Content="{x:Static res:Strings.Common_Cancel}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Options}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="18" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Chained steps (2, 3…) -->
            <ItemsControl ItemsSource="{Binding ExtraSteps}" IsVisible="{Binding HasSteps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="20" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepViewModel">
                  <Border Classes="inner">
                    <StackPanel Spacing="16">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                          <Button Classes="icon" Command="{Binding $parent[ItemsControl].((vm:ActionViewModel)DataContext).MoveStepUpCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{x:Static res:Strings.Chain_MoveUp}" ToolTip.Tip="{x:Static res:Strings.Chain_MoveUp}">
                            <controls:Icon Size="16" Data="{StaticResource IconUp}" />
                          </Button>
                          <Button Classes="icon" Command="{Binding $parent[ItemsControl].((vm:ActionViewModel)DataContext).MoveStepDownCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{x:Static res:Strings.Chain_MoveDown}" ToolTip.Tip="{x:Static res:Strings.Chain_MoveDown}">
                            <controls:Icon Size="16" Data="{StaticResource IconDown}" />
                          </Button>
                          <Button Classes="icon" Command="{Binding $parent[ItemsControl].((vm:ActionViewModel)DataContext).RemoveStepCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{x:Static res:Strings.Chain_Remove}" ToolTip.Tip="{x:Static res:Strings.Chain_Remove}">
                            <controls:Icon Size="16" Data="{StaticResource IconClose}" />
                          </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <controls:ModuleBadge Size="24" Tile="{Binding Tool.Module.Brush}" Icon="{Binding Tool.Module.Icon}" />
                          <TextBlock Classes="h2" Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding HasOptions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="18" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add a step: the actions that can work on what the last step produces -->
            <WrapPanel>
              <Panel IsVisible="{Binding CanAddStep}" Margin="0,0,10,0">
                <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding StartAddingStepCommand}" IsVisible="{Binding !IsChoosingStep}"
                        ToolTip.Tip="{x:Static res:Strings.Chain_AddStepHint}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:Icon Size="16" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="{x:Static res:Strings.Chain_AddStep}" />
                  </StackPanel>
                </Button>
              </Panel>
              <Button Classes="ghost" Command="{Binding StartSavingPresetCommand}"
                      IsVisible="{Binding CanStartSavingPreset}" Content="{x:Static res:Strings.Preset_Save}" />
            </WrapPanel>
            <StackPanel Spacing="10" IsVisible="{Binding CanAddStep}">
              <Border Classes="banner" IsVisible="{Binding IsChoosingStep}">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CancelAddingStepCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.Common_Cancel}" ToolTip.Tip="{x:Static res:Strings.Common_Cancel}">
                      <controls:Icon Size="16" Data="{StaticResource IconClose}" />
                    </Button>
                    <TextBlock Classes="label" Text="{x:Static res:Strings.Chain_ChooseStep}" VerticalAlignment="Center" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding NextStepTools}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ToolItemViewModel">
                        <Button Classes="ghost" Margin="0,0,8,8"
                                Command="{Binding $parent[ItemsControl].((vm:ActionViewModel)DataContext).AddStepCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Description}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:ModuleBadge Size="18" Tile="{Binding Module.Brush}" Icon="{Binding Module.Icon}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>


        <!-- Before / after comparison (image tools): the real result on one file -->
            <Border Classes="inner" IsVisible="{Binding CanCompare}">
              <StackPanel Spacing="12">
                <DockPanel>
                  <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ComparisonActualPixels}"
                                Content="{x:Static res:Strings.Compare_ActualPixels}" OnContent="" OffContent=""
                                ToolTip.Tip="{x:Static res:Strings.Compare_ActualPixelsHint}" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="h2" Text="{x:Static res:Strings.Compare_Title}" />
                    <TextBlock Classes="caption" Text="{Binding ComparisonFile.Name, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
                <Border Height="340" CornerRadius="{StaticResource RadiusSmall}" ClipToBounds="True"
                        Background="{DynamicResource SurfaceRaisedBrush}">
                  <Panel>
                    <controls:CompareView Before="{Binding Comparison.Before, FallbackValue={x:Null}}"
                                          After="{Binding Comparison.After, FallbackValue={x:Null}}"
                                          HandleBrush="{StaticResource LemonBrush}" HandleForeground="{StaticResource InkBrush}"
                                          AutomationProperties.Name="{x:Static res:Strings.Compare_Title}"
                                          AutomationProperties.HelpText="{x:Static res:Strings.Compare_Help}" />
                    <Border Classes="chip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,2"
                            IsVisible="{Binding HasComparison}" IsHitTestVisible="False">
                      <TextBlock Text="{x:Static res:Strings.Action_Before}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="chip" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,2"
                            IsVisible="{Binding HasComparison}" IsHitTestVisible="False">
                      <TextBlock Text="{x:Static res:Strings.Action_After}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <controls:Loader HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding ComparisonBusy}" IsHitTestVisible="False" />
                  </Panel>
                </Border>
                <TextBlock Classes="label" Text="{Binding ComparisonSizes}" IsVisible="{Binding HasComparison}" />
                <TextBlock Classes="error" Text="{Binding ComparisonError}" TextWrapping="Wrap"
                           IsVisible="{Binding ComparisonError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="caption" Text="{x:Static res:Strings.Compare_Help}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Before / after preview (rename) -->
            <Border Classes="inner" IsVisible="{Binding HasPreview}">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="{x:Static res:Strings.Action_Preview}" />
                <Grid ColumnDefinitions="*,32,*">
                  <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.Action_Before}" />
                  <TextBlock Grid.Column="2" Classes="caption" Text="{x:Static res:Strings.Action_After}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding PreviewRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tools:PreviewRow">
                      <Grid ColumnDefinitions="*,32,*" Margin="0,3">
                        <TextBlock Grid.Column="0" Classes="secondary" Text="{Binding Before}" TextTrimming="CharacterEllipsis" />
                        <controls:Icon Size="16" Grid.Column="1" Data="{StaticResource IconBack}" Foreground="{DynamicResource TextSecondaryBrush}" RenderTransform="rotate(180deg)" />
                        <TextBlock Grid.Column="2" Classes="label" Text="{Binding After}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Classes="error" Text="{Binding PreviewError}" IsVisible="{Binding PreviewError, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ToolRow" x:DataType="vm:ToolItemViewModel">
      <Border Classes="toolRow" Classes.open="{Binding IsSelected}">
        <StackPanel>
          <Button Classes="toolHeader" Command="{Binding $parent[UserControl].((vm:ActionViewModel)DataContext).SelectToolCommand}" CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Description}">
            <DockPanel>
              <controls:Icon Classes="chevron" DockPanel.Dock="Right" Size="16" Data="{StaticResource IconDown}" VerticalAlignment="Center" />
              <controls:ModuleBadge DockPanel.Dock="Left" Size="30" Margin="0,0,14,0" Tile="{Binding Module.Brush}" Icon="{Binding Module.Icon}" VerticalAlignment="Center" />
              <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Classes="label" Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Button>
          <ContentControl Classes="settings" Content="{Binding Host}" ContentTemplate="{StaticResource ToolSettings}" Margin="16,0,16,18"
                          IsVisible="{Binding IsSelected}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,24,360">

    <!-- Header -->
    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
      <Button Classes="icon" Command="{Binding BackCommand}" AutomationProperties.Name="{x:Static res:Strings.Common_Back}">
        <controls:Icon Size="20" Data="{StaticResource IconBack}" />
      </Button>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="h1" Text="{x:Static res:Strings.Action_Title}" />
        <TextBlock Classes="caption" Text="{Binding FilesSummary}" />
      </StackPanel>
    </StackPanel>

    <!-- Left: tool choice and settings -->
    <ScrollViewer Grid.Row="1" Grid.Column="0">
      <StackPanel Spacing="20" Margin="0,0,8,32">
        <Border Classes="banner" IsVisible="{Binding IsMixed}">
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.Action_MixedHint}" TextWrapping="Wrap" />
        </Border>

        <!-- Saved presets: one click picks the tool and its settings -->
        <StackPanel Spacing="8" IsVisible="{Binding HasPresets}">
          <TextBlock Classes="label" Text="{x:Static res:Strings.Preset_Title}" />
          <ItemsControl ItemsSource="{Binding Presets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PresetItemViewModel">
                <Border Classes="chip preset" Margin="0,0,8,8" Padding="4,4,4,4">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="ghost" Padding="8,4"
                            Command="{Binding $parent[ItemsControl].((vm:ActionViewModel)DataContext).ApplyPresetCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding}" ToolTip.Tip="{Binding Details}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:ModuleBadge Size="18" Tile="{Binding Module.Brush}" Icon="{Binding Module.Icon}" />
                        <TextBlock Classes="label" Text="{Binding Name}" VerticalAlignment="Center" />
                        <Border Classes="chip" Padding="6,0" VerticalAlignment="Center" IsVisible="{Binding StepsText, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <TextBlock Text="{Binding StepsText}" FontSize="11" />
                        </Border>
                      </StackPanel>
                    </Button>
                    <Button Classes="icon" MinWidth="28" MinHeight="28" Width="28" Height="28" Padding="0"
                            Command="{Binding $parent[ItemsControl].((vm:ActionViewModel)DataContext).StartRenamingPresetCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{x:Static res:Strings.Preset_Rename}" ToolTip.Tip="{x:Static res:Strings.Preset_Rename}">
                      <controls:Icon Size="13" Data="{StaticResource IconRename}" />
                    </Button>
                    <Button Classes="icon" MinWidth="28" MinHeight="28" Width="28" Height="28" Padding="0"
                            Command="{Binding $parent[ItemsControl].((vm:ActionViewModel)DataContext).DeletePresetCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{x:Static res:Strings.Preset_Delete}" ToolTip.Tip="{x:Static res:Strings.Preset_Delete}">
                      <controls:Icon Size="12" Data="{StaticResource IconClose}" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Actions, as an accordion: the one chosen by default first, then the recommended ones,
             then the others. The open action shows its settings under its name. -->
        <ItemsControl ItemsSource="{Binding DefaultTools}" ItemTemplate="{StaticResource ToolRow}" />
        <StackPanel Spacing="10" IsVisible="{Binding HasRecommended}">
          <TextBlock Classes="label" Text="{x:Static res:Strings.Action_Recommended}" Margin="4,8,0,0" />
          <ItemsControl ItemsSource="{Binding RecommendedTools}" ItemTemplate="{StaticResource ToolRow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
        <StackPanel Spacing="10" IsVisible="{Binding HasOther}">
          <TextBlock Classes="label" Text="{x:Static res:Strings.Action_OtherTools}" Margin="4,8,0,0" />
          <ItemsControl ItemsSource="{Binding OtherTools}" ItemTemplate="{StaticResource ToolRow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: files and launch -->
    <Border Grid.Row="1" Grid.Column="2" Classes="panel" Margin="0,0,0,32" Padding="20">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding AddFilesCommand}"
                  AutomationProperties.Name="{x:Static res:Strings.Action_AddFiles}"
                  ToolTip.Tip="{x:Static res:Strings.Action_AddFiles}">
            <controls:Icon Size="20" Data="{StaticResource IconPlus}" />
          </Button>
          <TextBlock Classes="h2" Text="{x:Static res:Strings.Action_Files}" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,16,0,0">
          <Border Classes="banner" IsVisible="{Binding HasWarning}">
            <DockPanel>
              <controls:Icon Size="16" DockPanel.Dock="Left" Data="{StaticResource IconAlert}" Foreground="{DynamicResource ErrorBrush}" Margin="0,2,10,0" VerticalAlignment="Top" />
              <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <!-- Destination -->
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.Output_Label}" />
            <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{x:Static res:Strings.Output_Label}" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost" Padding="10,2" MinHeight="30" IsVisible="{Binding IsCustomOutput}"
                      Command="{Binding ChangeOutputFolderCommand}" Content="{x:Static res:Strings.Output_Change}" />
              <TextBlock Classes="caption" Text="{Binding OutputDescription}" TextWrapping="Wrap" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding OutputDescription}" />
            </DockPanel>
            <StackPanel Spacing="2" IsVisible="{Binding ShowKeepTree}">
              <ToggleSwitch IsChecked="{Binding KeepTree}" Content="{x:Static res:Strings.Output_KeepTree}" OnContent="" OffContent="" />
              <TextBlock Classes="caption" Text="{x:Static res:Strings.Output_KeepTreeHint}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="secondary" Text="{Binding Estimate}" IsVisible="{Binding HasEstimate}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="{x:Static res:Strings.Action_OriginalsSafe}" TextWrapping="Wrap" />
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding LaunchCommand}" HotKey="{OnPlatform Ctrl+Enter, macOS=Meta+Enter}" ToolTip.Tip="{x:Static services:PlatformText.LaunchShortcut}"
                  AutomationProperties.Name="{Binding LaunchLabel}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Size="16" Data="{StaticResource IconPlay}" />
              <TextBlock Text="{Binding LaunchLabel}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <ListBox Classes="files" ItemsSource="{Binding Files}" Background="Transparent" SelectedItem="{Binding ComparisonFile}"
                 AutomationProperties.Name="{x:Static res:Strings.Action_Files}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FileItemViewModel">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="icon"
                        Command="{Binding $parent[ListBox].((vm:ActionViewModel)DataContext).RemoveFileCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{x:Static res:Strings.Action_RemoveFile}"
                        ToolTip.Tip="{x:Static res:Strings.Action_RemoveFile}">
                  <controls:Icon Size="16" Data="{StaticResource IconClose}" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                  <TextBlock Classes="caption" Text="{Binding SizeText}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
