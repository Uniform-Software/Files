<!--
  Logotype "unifiles": lowercase Bricolage Grotesque 800 with tight tracking, nothing else
  (same wordmark as the output folder icon).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniFiles.App.Controls.Logo"
             AutomationProperties.Name="UniFiles">
  <TextBlock Text="unifiles"
             FontFamily="{StaticResource DisplayFont}"
             FontWeight="ExtraBold"
             FontSize="30"
             LetterSpacing="-0.9"
             VerticalAlignment="Bottom" />
</UserControl>
